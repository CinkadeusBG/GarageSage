# ─── GarageSage Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=garagesage
DB_PASSWORD=change_me_strong_password_here
DB_NAME=garagesage

# Used by NestJS/Prisma directly (constructed by docker-compose from above)
DATABASE_URL=postgresql://garagesage:change_me_strong_password_here@localhost:5432/garagesage?schema=public

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_at_least_32_random_characters_here
JWT_EXPIRES_IN=7d

# ─── Ollama / AI ──────────────────────────────────────────────────────────────
# For production (Docker): http://ollama:11434
# For local dev:           http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Chat model — options: phi4-mini, llama3.2:3b, gemma3:4b
OLLAMA_MODEL=phi4-mini

# Embedding model — nomic-embed-text produces 768-dim vectors
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
UPLOADS_PATH=./uploads
