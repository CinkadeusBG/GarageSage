// libs/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         Role      @default(USER)
  vehicles     Vehicle[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

// ─── Vehicles ─────────────────────────────────────────────────────────────────

model Vehicle {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  make            String
  model           String
  trim            String?
  year            Int
  vin             String?          @unique
  licensePlate    String?
  color           String?
  currentMileage  Int              @default(0)
  photoUrl        String?
  notes           String?
  specs           Json?            // oil, tires, filters, spark, serviceNotes
  isActive        Boolean          @default(true)
  outOfService    Boolean          @default(false)
  maintenanceLogs MaintenanceLog[]
  reminders       Reminder[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
}

// ─── Maintenance Logs ─────────────────────────────────────────────────────────

model MaintenanceLog {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  mileage     Int
  type        String    // "Oil Change", "Tire Rotation", "Brakes", etc.
  description String?
  cost        Float?
  shop        String?
  technician  String?
  attachments String[]  // relative paths in uploads volume
  tags        String[]  // user-defined tags

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([date])
  @@index([type])
}

// ─── Reminders ────────────────────────────────────────────────────────────────

model Reminder {
  id              String         @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String?        // "Oil", "Tires", "Inspection", etc.
  intervalMileage Int?           // recur every N miles
  intervalDays    Int?           // recur every N days
  lastDoneMileage Int?
  lastDoneDate    DateTime?
  nextDueMileage  Int?
  nextDueDate     DateTime?
  status          ReminderStatus @default(ACTIVE)
  priority        Priority       @default(MEDIUM)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([vehicleId])
  @@index([status])
}

enum ReminderStatus {
  ACTIVE
  SNOOZED
  COMPLETED
  DISMISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
