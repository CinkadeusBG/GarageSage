{
  "name": "garagesage",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"nx serve api\" \"nx serve frontend\"",
    "build": "nx run-many -t build --projects=api,frontend --prod",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "db:migrate": "prisma migrate dev --schema=libs/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=libs/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=libs/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=libs/prisma/schema.prisma"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/serve-static": "^4.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.10.0",
    "@angular/animations": "^18.0.0",
    "@angular/cdk": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@angular/service-worker": "^18.0.0",
    "@primeng/themes": "^18.0.0",
    "primeng": "^18.0.0",
    "primeicons": "^7.0.0",
    "primeflex": "^3.3.1",
    "chart.js": "^4.4.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-writer": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
